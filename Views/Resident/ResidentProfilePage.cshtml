@{
    Layout = "~/Views/Shared/iKonnekta_51_Layout.cshtml";
}
<!-- TOPBAR -->
<nav class="topbar">
    <button class="icon-btn hamburger-btn" ng-click="toggleSidebar()" title="Menu">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
    </button>
    <span class="topbar-brand">iKonnekta-51</span>
    <div class="topbar-right">
        <button class="icon-btn" title="Notifications">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
        </button>
        <div class="user-info">
            <div class="user-name">{{ user.name }}</div>
            <div class="user-id">{{ user.id }}</div>
        </div>
        <button class="icon-btn" ng-click="navigate('login')">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
            </svg>
        </button>
    </div>
</nav>

<!-- Overlay -->
<div class="sidebar-overlay"
     ng-class="{ open: sidebarOpen }"
     ng-click="closeSidebar()">
</div>

<div class="app-container">
    <!-- SIDEBAR -->
    <aside class="sidebar" ng-class="{ open: sidebarOpen }">
        <a class="nav-item" ng-click="navigate('residentDashboard') ; closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Dashboard
        </a>
        <a class="nav-item" ng-click="navigate('submitRequest') ; closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            Submit Request
        </a>
        <a class="nav-item" ng-click="navigate('trackRequest'); closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Track Requests
        </a>
        <a class="nav-item" ng-click="navigate('requestHistorypage'); closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Request History
        </a>
        <a class="nav-item" ng-click="navigate('residentProfile'); closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            User Profile
        </a>
        <a class="nav-item" ng-click="navigate('notification')'; closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            Notification
        </a>
    </aside>

    <main class="main-content">
        <div class="mt-10 max-w-2xl mx-auto">
            <!-- Page Header -->
            <div class="content-wrapper">
                <h1 class="text-2xl font-bold text-slate-900">My Profile</h1>
                <p class="text-sm text-slate-500 mt-1">View and manage your personal information</p>
            </div>

            <!-- Profile Card -->
            <div class="card2 rounded-2xl shadow-sm border border-slate-200 p-6" ng-show="showProfileCard">

                <!-- Profile Header -->
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-4">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900">Juan Dela Cruz</h2>
                            <p class="text-sm text-slate-500">Resident Account</p>
                        </div>
                    </div>
                    <button class="bg-blue-600 hover:bg-blue-700 transition-colors text-white
                               text-sm font-medium px-5 py-2.5 rounded-lg cursor-pointer"
                            ng-click="showEditProfileFunc()">
                        Edit Profile
                    </button>
                </div>

                <!-- Divider -->
                <hr class="border-slate-100 mb-6" />

                <!-- Info Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

                    <!-- Full Name -->
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                            </svg>
                            <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Full Name</span>
                        </div>
                        <p class="text-sm font-semibold text-slate-800">Juan Dela Cruz</p>
                        <p class="text-xs text-slate-400 mt-0.5">Cannot be changed</p>
                    </div>

                    <!-- RBI ID -->
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z" />
                            </svg>
                            <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">RBI ID</span>
                        </div>
                        <p class="text-sm font-semibold text-slate-800">RBI-2024-001</p>
                        <p class="text-xs text-slate-400 mt-0.5">Cannot be changed</p>
                    </div>

                    <!-- Birth Date -->
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                            </svg>
                            <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Birth Date</span>
                        </div>
                        <p class="text-sm font-semibold text-slate-800">May 15, 1990</p>
                        <p class="text-xs text-slate-400 mt-0.5">Cannot be changed</p>
                    </div>

                    <!-- Contact Number -->
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                            </svg>
                            <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Contact Number</span>
                        </div>
                        <p class="text-sm font-semibold text-slate-800">09171234567</p>
                    </div>

                    <!-- Address -->
                    <div class="sm:col-span-2">
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                            </svg>
                            <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Address</span>
                        </div>
                        <p class="text-sm font-semibold text-slate-800">123 Main St, Barangay 52</p>
                    </div>

                </div>
            </div>
            <!--edit profile form-->
            <div class="card flex flex-col gap-2  " ng-show="showEditProfileCard">
                <h2 class="text-xl font-semibold text-gray-900 mb-1">Edit Your Profile</h2>
                <div class="flex flex-col gap-3">
                    <div class="flex gap-2">
                        <div class="flex-1 flex flex-col gap-1">
                            <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">First Name</label>
                            <input type="text"
                                   class="w-full h-10 px-3 rounded-lg border border-gray-300 bg-gray-50 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition" />

                        </div>
                        <div class="flex-1 flex flex-col gap-1">
                            <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Last Name</label>
                            <input type="text"
                                   class="w-full h-10 px-3 rounded-lg border border-gray-300 bg-gray-50 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition" />

                        </div>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Mobile Number</label>
                        <input type="text"
                               ng-model="phone"
                               inputmode="numeric"
                               maxlength="11"
                               class="h-10 px-3 rounded-lg border border-gray-300 bg-gray-50 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition">
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Address</label>
                        <input type="text" class="h-10 px-3 rounded-lg border border-gray-300 bg-gray-50 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition" />
                    </div>
                    <div class="flex justify-end gap-2 mt-2">
                        <button class="bg-gray-400 hover:bg-gray-700 transition-colors text-white text-sm font-medium px-5 py-2.5 rounded-lg cursor-pointer"
                                ng-click="cancelUpdeteProfileFunc()">
                            Cancel
                        </button>
                        <button class="bg-blue-600 hover:bg-blue-700 transition-colors text-white text-sm font-medium px-5 py-2.5 rounded-lg cursor-pointer"
                                ng-click="saveChangesProfileFunc()">
                            Save changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

