v@{
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
}

<!-- Main Content -->
<div class="app-container">
    <main class="main-content">
        <div class="content-wrapper p-6">
            <h1 class="greeting-user">Welcome User</h1>
            <p class="shortDescription">Manage your document requests</p>
        </div>
        <div class="content-wrapper2">
            <div class="stat-card border border-[#BEDBFF] bg-[#EFF6FF]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#2B7FFF]">Total Requested Document</p>
                        <p class="stat-number text-[#1C398E]">{{ dashboardStats.total }}</p>
                    </div>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#2B7FFF" class="size-9">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>

                </div>
            </div>
            <div class="stat-card border border-[#FFF085] bg-[#FEFCE8]" >
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#A65F00]">Processing</p>
                        <p class="stat-number text-[#733E0A]">{{ dashboardStats.processing }}</p>
                    </div>
                    <svg width="40" height="40" fill="none" stroke="#EAB308" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
            <div class="stat-card bg-[#F0FDF4] border border-[#B9F8CF]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#008236]">Ready for Pickup</p>
                        <p class="stat-number text-[#0D542B]">{{ dashboardStats.ready }}</p>
                    </div>
                    <svg width="40" height="40" fill="none" stroke="#22C55E" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
            <div class="stat-card bg-[#F9FAFB] border border-[#E5E7EB]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#364153]">Complete</p>
                        <p class="stat-number text-[#101828]">{{ dashboardStats.completed }}</p>
                    </div>
                    <svg fill="none" width="40" height="40" viewBox="0 0 24 24" stroke-width="2" stroke="#6A7282" class="size-9">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>

                </div>
            </div>
        </div>
        <div>
            <div class="card2">
                <h2 class="text-xl font-bold mb-6">Quick Actions</h2>
                <div class="content-wrapper2 md:flex gap-2">

                    <div class="stat-card flex-1 cursor-pointer group flex items-center gap-3 border hover:border-[#155DFC]">
                        <div class="stat-card-inner gap-4">
                            <div class="text-gray-500 group-hover:text-[#155DFC]">
                                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                </svg>
                            </div>

                            <div class="flex flex-col" ng-click="navigate('submitRequest')">
                                <h4 class="text-lg font-semibold text-[#101828]">Submit New Request</h4>
                                <p class="text-base text-[#4A5565]">Request a new document</p>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card  flex-1 cursor-pointer group flex items-center gap-3 border hover:border-[#155DFC]">
                        <div class="stat-card-inner gap-4">
                            <div class="text-gray-500 group-hover:text-[#155DFC]">
                                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                                </svg>

                            </div>


                            <div class="flex flex-col" ng-click="navigate('trackRequest')">
                                <h4 class="text-lg font-semibold text-[#101828]">Track Requests</h4>
                                <p class="text-base text-[#4A5565]">View all active requests</p>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card  flex-1 cursor-pointer group flex items-center gap-3 border hover:border-[#155DFC]">
                        <div class="text-gray-500 group-hover:text-[#155DFC]">
                            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>


                        </div>

                        <div class="flex flex-col" ng-click="navigate('requestHistorypage')">
                            <h4 class="text-lg font-semibold text-[#101828]">Request History</h4>
                            <p class="text-base text-[#4A5565]">View all pasts requests</p>
                        </div>

                    </div>
                </div>

            </div>

            <div class="card2">
                <h2 class="text-base font-bold mb-3">Recent Requests</h2>
                <hr class="border-gray-200 mb-4">

                <!-- Empty state -->
                <div ng-if="requests.length === 0">
                    <p class="text-xs text-gray-400">No requests found.</p>
                </div>

                <!-- Request list -->
                <div ng-repeat="request in requests"
                     class="flex justify-between items-start"
                     ng-class="{ 'mb-4 pb-4 border-b border-gray-100': !$last }">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <h3 class="text-sm font-bold">{{ request.type }}</h3>
                            <span class="bg-blue-100 text-blue-600 border border-blue-200 text-xs font-medium px-3 py-0.5 rounded-full">
                                {{ request.status }}
                            </span>
                        </div>
                        <p class="text-xs text-gray-500">Request ID: {{ request.id }}</p>
                        <p class="text-xs text-gray-500">Purpose: {{ request.purpose }}</p>
                        <p class="text-xs text-gray-400 mt-2">Submitted: {{ request.submitted }}</p>
                    </div>

                    <a href=""
                       ng-click="navigate('trackRequest', request.id)"
                       class="text-blue-600 text-sm hover:underline self-center">
                        View Details
                    </a>
                </div>

            </div>
        </div>
    </main>
</div>
