@{
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
}
<!-- Main Content -->
<div class="app-container">
    <main class="main-content">

        <!-- Header -->
        <div class="content-wrapper p-6">
            <h1 class="greeting-user">Welcome User</h1>
            <p class="shortDescription">Manage your document requests</p>
        </div>

        <!-- Stats -->
        <div class="content-wrapper2">

            <div class="stat-card border border-[#BEDBFF] bg-[#EFF6FF]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#2B7FFF]">Total Requested Document</p>
                        <p class="stat-number text-[#1C398E]">{{ dashboardStats.total }}</p>
                    </div>
                </div>
            </div>

            <div class="stat-card border border-[#FFF085] bg-[#FEFCE8]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#A65F00]">Processing</p>
                        <p class="stat-number text-[#733E0A]">{{ dashboardStats.processing }}</p>
                    </div>
                </div>
            </div>

            <div class="stat-card bg-[#F0FDF4] border border-[#B9F8CF]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#008236]">Ready for Pickup</p>
                        <p class="stat-number text-[#0D542B]">{{ dashboardStats.ready }}</p>
                    </div>
                </div>
            </div>

            <div class="stat-card bg-[#F9FAFB] border border-[#E5E7EB]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#364153]">Complete</p>
                        <p class="stat-number text-[#101828]">{{ dashboardStats.completed }}</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Quick Actions -->
        <div class="card2">
            <h2 class="text-xl font-bold mb-6">Quick Actions</h2>

            <div class="content-wrapper2 md:flex gap-2">

                <div class="stat-card flex-1 cursor-pointer group border hover:border-[#155DFC]">
                    <div class="stat-card-inner">
                        <div ng-click="navigate('submitRequest')">
                            <h4 class="text-lg font-semibold">Submit New Request</h4>
                            <p class="text-base text-gray-500">Request a new document</p>
                        </div>
                    </div>
                </div>

                <div class="stat-card flex-1 cursor-pointer group border hover:border-[#155DFC]">
                    <div class="stat-card-inner">
                        <div ng-click="navigate('trackRequest')">
                            <h4 class="text-lg font-semibold">Track Requests</h4>
                            <p class="text-base text-gray-500">View all active requests</p>
                        </div>
                    </div>
                </div>

                <div class="stat-card flex-1 cursor-pointer group border hover:border-[#155DFC]">
                    <div class="stat-card-inner">
                        <div ng-click="navigate('requestHistorypage')">
                            <h4 class="text-lg font-semibold">Request History</h4>
                            <p class="text-base text-gray-500">View past requests</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Recent Requests -->
        <div class="card2" ng-init="loadRecentRequest()">

            <h2 class="text-base font-bold mb-3">Recent Requests</h2>
            <hr class="border-gray-200 mb-4">

            <!-- Empty -->
            <div ng-if="!requests || requests.length === 0">
                <p class="text-xs text-gray-400">No requests found.</p>
            </div>

            <!-- List -->
            <div ng-repeat="request in requests track by request.requestId"
                 class="flex justify-between items-start"
                 ng-class="{ 'mb-4 pb-4 border-b border-gray-100': !$last }">

                <div>

                    <!-- Document + Status -->
                    <div class="flex items-center gap-2 mb-1">

                        <h3 class="text-sm font-bold">
                            {{ request.documentType }}
                        </h3>

                        <span class="bg-blue-100 text-blue-600 border border-blue-200 text-xs font-medium px-3 py-0.5 rounded-full">
                            {{ request.progress }}
                        </span>

                    </div>

                    <!-- Request ID -->
                    <p class="text-xs text-gray-500">
                        Request ID: {{ request.requestId }}
                    </p>

                    <!-- Purpose -->
                    <p class="text-xs text-gray-500">
                        Purpose: {{ request.purpose }}
                    </p>

                    <!-- Date -->
                    <p class="text-xs text-gray-400 mt-2">
                        Submitted:
                        {{ (request.submittedDate.replace('/Date(', '').replace(')/', '') * 1) | date:'yyyy-MM-dd hh:mm a' }}
                    </p>

                </div>

                <!-- Action -->
                <a ng-click="navigate('trackRequest', request.requestId)"
                   class="text-blue-600 text-sm hover:underline self-center cursor-pointer">
                    View Details
                </a>

            </div>

        </div>

    </main>
</div>