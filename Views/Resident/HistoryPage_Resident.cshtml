@{
    Layout = "~/Views/Shared/iKonnekta_51_Layout.cshtml";
}
<!-- TOPBAR -->
<nav class="topbar">
    <button class="icon-btn hamburger-btn" ng-click="toggleSidebar()" title="Menu">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
    </button>
    <span class="topbar-brand">iKonnekta-51</span>
    <div class="topbar-right">
        <button class="icon-btn" title="Notifications">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
        </button>
        <div class="user-info">
            <div class="user-name">{{ user.name }}</div>
            <div class="user-id">{{ user.id }}</div>
        </div>
        <button class="icon-btn" ng-click="navigate('login')">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
            </svg>
        </button>
    </div>
</nav>

<!-- Overlay -->
<div class="sidebar-overlay"
     ng-class="{ open: sidebarOpen }"
     ng-click="closeSidebar()">
</div>

<div class="app-container">
    <!-- SIDEBAR -->
    <aside class="sidebar" ng-class="{ open: sidebarOpen }">
        <a class="nav-item" ng-click="navigate('residentDashboard') ; closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Dashboard
        </a>
        <a class="nav-item" ng-click="navigate('submitRequest') ; closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            Submit Request
        </a>
        <a class="nav-item" ng-click="navigate('trackRequest'); closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Track Requests
        </a>
        <a class="nav-item" ng-click="navigate('requestHistorypage'); closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Request History
        </a>
        <a class="nav-item" ng-click="navigate('residentProfile'); closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            User Profile
        </a>
        <a class="nav-item" ng-click="navigate('notification')'; closeSidebar()">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            Notification
        </a>
    </aside>

    <main class="main-content">
        <div class="p-6">
            <!-- Header -->
            <h2 class="text-2xl font-bold text-gray-900">Request History and records</h2>
            <p class="text-sm text-gray-500 mb-4">View all document requests</p>

            <!-- Empty State -->
            @*ng-if="requests.length === 0"*@
            <div class="bg-white border border-gray-200 rounded-xl p-16 flex flex-col items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3 class="text-base font-semibold text-gray-800 mb-1">No History Yet</h3>
                <p class="text-sm text-gray-400">Your completed requests will appear here.</p>
            </div>

            <!-- Request List -->
            @*<div ng-if="requests.length > 0"
                     class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
                    <div ng-repeat="request in requests"
                         class="flex justify-between items-start px-6 py-4">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="text-sm font-bold text-gray-800">{{ request.documentType }}</h3>
                                <span ng-class="{
                            'bg-yellow-100 text-yellow-600 border border-yellow-300': request.status === 'Processing',
                            'bg-green-100 text-green-600 border border-green-300': request.status === 'Approved',
                            'bg-red-100 text-red-600 border border-red-300': request.status === 'Rejected'
                        }" class="text-xs font-medium px-3 py-0.5 rounded-full">
                                    {{ request.status }}
                                </span>
                            </div>
                            <p class="text-xs text-gray-500">Request ID: {{ request.requestId }}</p>
                            <p class="text-xs text-gray-500">Purpose: {{ request.purpose }}</p>
                            <p class="text-xs text-gray-400 mt-1">Submitted: {{ request.submittedDate }}</p>
                        </div>
                        <a href="#" class="text-blue-600 text-sm hover:underline self-center">View Details</a>
                    </div>
                </div>*@

        </div>
    </main>
</div>

