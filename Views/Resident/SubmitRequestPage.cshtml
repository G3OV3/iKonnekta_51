@{
    Layout = "~/Views/Shared/_ResidentLayout.cshtml";
}
<div class="app-container">


    <main class="main-content">
        <div class="card max-w-2xl mx-auto">

            <!-- Header -->
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-200">
                <div class="text-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-gray-900">Submit Document Request</h1>
                    <p class="text-sm text-gray-500">Fill out the form below to request a document</p>
                </div>
            </div>

            <!-- Document Type -->
            <div class="mb-4">
                <label class="dropDown">Document Type</label>
                <select class="dropdown-label">
                    <option value="">Select Document</option>
                    <option value="barangay_clearance">Barangay Clearance</option>
                    <option value="cedula">Cedula</option>
                    <option value="indigency">Indigency</option>
                </select>
            </div>

            <!-- Purpose -->
            <div class="mb-4">
                <label class="dropDown">Purpose</label>
                <select class="dropdown-label">
                    <option value="employment">Employment</option>
                    <option value="travel">Travel</option>
                    <option value="school">School</option>
                    <option value="loan">Loan</option>
                </select>
            </div>

            <!-- First Name & Last Name -->
            <div class="flex gap-4 mb-4">
                <div class="flex-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                    <input type="text" value="User's First Name"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500" readonly />
                </div>
                <div class="flex-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                    <input type="text" value="User's Last Name"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500" readonly />
                </div>
            </div>

            <!-- Address -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
                <input type="text" value="123 Play ground street gracepark caloocan city"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500" readonly />
            </div>

            <!-- Contact -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Contact</label>
                <input type="text" value="09296814595"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500" readonly />
            </div>
            <!-- Note -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg px-4 py-3 mb-6 text-sm text-blue-700">
                <span class="font-semibold">Note:</span> Processing time is typically 3 business days. You will receive a notification once your document is ready for pickup.
            </div>

            <!-- Buttons -->
            <div class="flex gap-4 pt-4 border-t border-gray-200">
                <button class="flex-1 py-2 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50">
                    Cancel
                </button>
                <button class="flex-1 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700">
                    Submit Request
                </button>
            </div>

        </div>

    </main>
</div>

