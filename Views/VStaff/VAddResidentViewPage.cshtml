@{
    Layout = "~/Views/Shared/_VStaffLayoutPage.cshtml";
}
<main class="app-container">
    <div class="main-content">
        <div class="card max-w-2xl mx-auto">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-200">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Add A resident</h2>
                    <p class="text-sm text-gray-500">Fill out the List a Resident</p>
                </div>
            </div>
            <div class="space-y-6">
                <!-- Row 1 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">PhySys Card No.</label>
                        <input type="text" 
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Last Name Name</label>
                        <input type="text"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    <div class="md:col-span-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                        <input type="text"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div class="md:col-span-4">
                        <label class="form-label">Suffix</label>
                        <input type="text" class="form-input" placeholder="">
                    </div>
                    <div class="md:col-span-4">
                        <label class="form-label">Middle Name</label>
                        <input type="text" class="form-input" placeholder="">
                    </div>
                </div>

                <!-- Row 3 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="form-label">Birth Date</label>
                        <input type="date" class="form-input">
                    </div>
                    <div>
                        <label class="form-label">Birth Place</label>
                        <input type="text" class="form-input" placeholder="">
                    </div>
                </div>

                <!-- Row 4 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="form-label">Sex</label>
                        <select class="form-select">
                            <option value="" disabled selected>Select Sex</option>
                            <option>Male</option>
                            <option>Female</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Civil Status</label>
                        <select class="form-select">
                            <option value="" disabled selected>Select Status</option>
                            <option>Single</option>
                            <option>Married</option>
                            <option>Widowed</option>
                            <option>Separated</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Religious</label>
                        <select class="form-select">
                            <option value="" disabled selected>Select Religion</option>
                            <option>Roman Catholic</option>
                            <option>Iglesia Ni Cristo</option>
                            <option>Islam</option>
                            <option>Other</option>
                        </select>
                    </div>
                </div>

                <!-- Row 5 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="form-label">Residence Address</label>
                        <input type="text" class="form-input" placeholder="">
                    </div>
                    <div>
                        <label class="form-label">Citizenship</label>
                        <input type="text" class="form-input" placeholder="">
                    </div>
                </div>

                <!-- Row 6 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="form-label">Profession</label>
                        <input type="text" class="form-input" placeholder="">
                    </div>
                    <div>
                        <label class="form-label">Contact Number</label>
                        <input type="text" class="form-input" placeholder="">
                    </div>
                    <div>
                        <label class="form-label">Email Address</label>
                        <input type="email" class="form-input" placeholder="">
                    </div>
                </div>

                <!-- Row 7 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="form-label">Educational Attainment</label>
                        <select class="form-select">
                            <option value="" disabled selected>Select Education</option>
                            <option>Elementary</option>
                            <option>High School</option>
                            <option>Vocational</option>
                            <option>College Graduate</option>
                            <option>Post-Graduate</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Date Registered</label>
                        <input type="date" class="form-input">
                    </div>
                    <div>
                        <label class="form-label">Assigned House Hold Number</label>
                        <input type="text" class="form-input" placeholder="">
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col md:flex-row gap-4 pt-6 mt-8 border-t border-gray-100">
                    <button type="button" class="flex-1 py-3 border border-gray-200 rounded-xl font-bold text-gray-500 hover:bg-gray-50 transition-all" ng-click="toggleForm()">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 py-3 bg-[#155DFC] text-white rounded-xl font-bold shadow-lg shadow-blue-100 hover:bg-blue-700 transition-all">
                        Register Resident
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>