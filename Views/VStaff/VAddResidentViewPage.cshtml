@{
    Layout = "~/Views/Shared/_VStaffLayoutPage.cshtml";
}
<main class="app-container">
    <div class="main-content">
        <div class="card max-w-2xl mx-auto">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-200">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Add A resident</h2>
                    <p class="text-sm text-gray-500">Fill out the List a Resident</p>
                </div>
            </div>
            <div class="space-y-6">
                <!-- Row 1 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" >
                              PhySys Card No.<span class="text-red-400">*</span></label>
                        <input type="text"
                               ng-model="cardNo"
                               inputmode="numeric"
                                maxlength="11"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Last Name<span class="text-red-400">*</span></label>
                        <input type="text" maxlength="15" ng-model="fillLn"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    <div class="md:col-span-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">First Name <span class="text-red-400">*</span></label>
                        <input type="text" maxlength="15" ng-model="fillFn"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div class="md:col-span-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Suffix</label>
                        <input type="text" maxlength="3" ng-model="fillSuffix"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div class="md:col-span-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Middle Name <span class="text-red-400">*</span></label>
                        <input type="text"  maxlength="15" ng-model="fillMn"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>

                <!-- Row 3 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Birth Date <span class="text-red-400">*</span></label>
                        <input type="date" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                               ng-model="fillBDate">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Birth Place <span class="text-red-400">*</span></label>
                        <input type="text" ng-model="fillBPlace"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>

                <!-- Row 4 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="dropDown">Sex <span class="text-red-400">*</span></label>
                        <select class="dropdown-label" ng-model="fillSex">
                            <option value="" disabled selected>Select</option>
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                            <option value="disclosed">Disclosed</option>
                        </select>
                    </div>
                    <div>
                        <label class="dropDown">Civil Status <span class="text-red-400">*</span></label>
                        <select class="dropdown-label" ng-model="fillCivilStatus">
                            <option value="" disabled selected>Select civil status</option>
                            <option value="single">Single</option>
                            <option value="married">Married</option>
                            <option value="widowed">Widowed</option>
                            <option value="seperated">Separated</option>
                        </select>
                    </div>
                    <div>
                        <label class="dropDown">Religion <span class="text-red-400">*</span></label>
                        <select class="dropdown-label" ng-model="fillReligion">
                            <option value="" disabled selected>Select religion</option>
                            <option value="roman_catholic">Roman Catholic</option>
                            <option value="iglesia_ni_cristo">Iglesia Ni Cristo</option>
                            <option value="islam">Islam</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                </div>

                <!-- Row 5 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Address <span class="text-red-400">*</span></label>
                        <input type="text" maxlength="50" ng-model="fillAddress"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Citizenship <span class="text-red-400">*</span></label>
                        <input type="text" maxlength="20"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>

                <!-- Row 6 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Profession <span class="text-red-400">*</span></label>
                        <input type="text" maxlength="50"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Contact Number <span class="text-red-400">*</span></label>
                        <input type="text"
                                ng-model="phone"
                                inputmode="numeric"
                                maxlength="11"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                        <input type="email" 
                            ng-model="inputEmail"  
                            ng-model-options="{ allowInvalid: true }"
                            ng-change="checkAtSign()"
                            ng-blur="checkAtSign()"
                            maxlength="100"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <span ng-show="warningMessage" class="text-xs text-red-400">{{warningMessage}}</span>
                    </div>
                </div>

                <!-- Row 7 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="dropDown">
                           Academic Attainment <span class="text-red-400">*</span>
                        </label>
                        <select class="dropdown-label" ng-model="fillAcadAttainment">
                            <option value="" disabled selected>Select attainment</option>
                            <option value="elementary">Elementary</option>
                            <option value="high_school">High School</option>
                            <option value="vocational">Vocational</option>
                            <option value="college_graduate">College Graduate</option>
                            <option>
                                Post-Graduate
                            </option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Date Registered <span class="text-red-400">*</span></label>
                        <input type="date" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                               ng-model="fillDateReg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Household Number <span class="text-red-400">*</span></label>
                        <input type="text"
                                ng-model="digit"
                                inputmode="numeric"
                               maxlength="2"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-500 bg-white-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col md:flex-row gap-4 pt-6 mt-8 border-t border-gray-100">
                    <button type="button" ng-click="navigate('ListOfResidents')" class="flex-1 py-3 border border-gray-200 rounded-xl font-bold text-gray-500 hover:bg-gray-50 transition-all cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 py-3 bg-[#155DFC] text-white rounded-xl font-bold shadow-lg shadow-blue-100 hover:bg-blue-700 transition-all cursor-pointer">
                        Register Resident
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>
