@{
    Layout = "~/Views/Shared/_VStaffLayoutPage.cshtml";
}
<main class="app-container">
    <div class="main-content">
        <div>
            <div class="flex items-center justify-between mb-8 max-w-4xl mx-auto">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Process Request</h1>
                    <p class="text-xs font-bold text-gray-400">Request ID: REQ-001</p>
                </div>
                <div class="px-4 py-1 rounded-full text-[10px] font-bold bg-[#EBF2FF] text-[#155DFC] uppercase tracking-wider">
                    Processing
                </div>
            </div>
            <div class="max-w-4xl mx-auto space-y-4">
                <div class="card3 max-w-4xl mx-auto w-full">
                    <span class="section-title block mb-6"><b>Resident Information</b></span>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12">
                        <div>
                            <span class="info-label">Full Name</span>
                            <p class="info-value">Juan Dela Cruz</p>
                        </div>
                        <div>
                            <span class="info-label">Contact Number</span>
                            <p class="info-value">09664524621</p>
                        </div>
                        <div class="md:col-span-2">
                            <span class="info-label">Address</span>
                            <p class="info-value">123 Main St, Barangay 52</p>
                        </div>
                    </div>
                </div>
                <div class="card3">
                    <span class="section-title block mb-6"><b>Resident Information</b></span>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12">
                        <div>
                            <span class="info-label">Document Type</span>
                            <p class="info-value">Barangay Clearance</p>
                        </div>
                        <div>
                            <span class="info-label">Purpose</span>
                            <p class="info-value">Employment</p>
                        </div>
                        <div>
                            <span class="info-label">Date Requested</span>
                            <p class="info-value">April 26, 2026</p>
                        </div>
                    </div>
                </div>
                <div class="card3">
                    <span class="section-title block mb-6"><b>Resident Status</b></span>
                    <select class="dropDown2 font-bold">
                        <option>Processing</option>
                        <option>Ready for Pickup</option>
                        <option>Claimed</option>
                    </select>
                </div>
                <div class="card3">
                    <span class="section-title block mb-6"><b>Send Notification to Resident</b></span>
                    <div class="mb-5">
                        <label class="info-label !text-gray-500 font-bold mb-6">Message</label>
                        <textarea class="textArea h-28 resize-none" placeholder="Type a message to notify the resident..." ng-model="notificationMsg"></textarea>
                    </div>
                    <div class="flex flex-wrap gap-2 mb-6">
                        <button class="px-4 py-2 bg-gray-50 text-[11px] font-bold text-gray-500 rounded-lg hover:bg-gray-100 border border-gray-100 transition-all" ng-click="notificationMsg = 'Your request is currently being processed. Please wait for further updates.'">
                            Template: Processing
                        </button>
                        <button class="px-4 py-2 bg-gray-50 text-[11px] font-bold text-gray-500 rounded-lg hover:bg-gray-100 border border-gray-100 transition-all" ng-click="notificationMsg = 'Additional requirements are needed for your request. Please visit the barangay hall.'">
                            Template: Additional Requirements
                        </button>
                    </div>
                    <button class="bg-[#93C5FD] text-white px-6 py-2.5 rounded-lg font-bold text-[13px] flex items-center gap-2 hover:bg-blue-400 transition-all cursor-pointer">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                        Send Notification
                    </button>
                </div>
                <div class="card3">
                    <span class="section-title block mb-6"><b>Type of Document</b></span>
                    <div class="space-y-4">
                        <select class="dropDown2 !h-14 !text-lg">
                            <option>Barangay Clearance</option>
                            <option>Certificate of Indigency</option>
                        </select>
                        <button class="bg-[#155DFC] text-white px-6 py-3 rounded-xl font-bold text-[13px] flex items-center gap-2 hover:bg-blue-700 shadow-md cursor-pointer">
                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
                            Print Document
                        </button>
                    </div>
                </div>
                <div class="card3 !mb-12">
                    <span class="section-title block mb-6"><b>Quick Action</b></span>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <button class="bg-[#155DFC] text-white py-3.5 rounded-xl font-bold text-[13px] hover:bg-blue-700 cursor-pointer">
                            Apply Changes
                        </button>
                        <button class="bg-white border border-gray-200 text-gray-500 py-3.5 rounded-xl font-bold text-[13px] hover:bg-gray-50 cursor-pointer" ng-click="navigate('ManageRequests')">
                            Back to Requests
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</main>