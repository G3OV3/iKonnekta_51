@{
    Layout = "~/Views/Shared/_VStaffLayoutPage.cshtml";
}
<main class="app-container">
    <div class="main-content">
        <div class="content-wrapper  p-6">
            <h1 class="greeting-user">Manage Requests</h1>
            <p class="shortDescription">View all Pending document requests</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-8 shadow-sm">
            <div class="flex flex-col md:flex-row gap-4 items-center">
                <!-- Search Input -->
                <div class="relative flex-1 w-full">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    </div>
                    <input type="text"
                           class="block w-full pl-11 pr-4 py-3 border border-gray-100 rounded-xl bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-100 focus:border-blue-400 outline-none transition-all text-sm"
                           placeholder="Search by ID, resident name, or document type...">
                </div>
                <!-- Filter Button -->
                <button class="icon-btn p-3 bg-gray-50 border border-gray-100 rounded-xl hover:bg-gray-100">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" /></svg>
                </button>
                <!-- Status Dropdown Placeholder -->
                <div class="w-full md:w-48">
                    <select class="block w-full px-4 py-3 border border-gray-100 rounded-xl bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-100 outline-none text-sm appearance-none">
                        <option>Arranged By Oldest</option>
                        <option>Arranged By Latest</option>
                        <option>Arranged By Priority</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="md:col-span-9 col-span-12 p-4 bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm flex justify-center">

            <div class="overflow-x-auto w-full" ng-init="loadManageRequests()">

                <table class="w-full custom-table border-collapse text-center">

                    <thead>
                        <tr class="bg-[#FBFDFF]">
                            <th class="border-b px-4 py-4">Request ID</th>
                            <th class="border-b px-4 py-4">Resident Name</th>
                            <th class="border-b px-4 py-4">Mobile Number</th>
                            <th class="border-b px-4 py-4">Document Type</th>
                            <th class="border-b px-4 py-4">Purpose</th>
                            <th class="border-b px-4 py-4">Status</th>
                            <th class="border-b px-4 py-4">Date Requested</th>
                            <th class="border-b px-4 py-4">Priority</th>
                            <th class="border-b px-4 py-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <!-- EMPTY -->
                        <tr ng-if="!manageReqsArr || manageReqsArr.length === 0">
                            <td colspan="9" class="text-center py-6 text-gray-400">
                                No requests found.
                            </td>
                        </tr>

                        <!-- DATA -->
                        <tr ng-repeat="req in manageReqsArr track by req.requestId"
                            class="hover:bg-gray-50 transition-colors">

                            <td class="font-semibold px-4 py-4">{{ req.requestId }}</td>

                            <td class="font-semibold px-4 py-4">{{ req.residentName }}</td>

                            <td class="px-4 py-4">{{ req.mobileNumber }}</td>

                            <td class="px-4 py-4">{{ req.documentType }}</td>

                            <td class="px-4 py-4">{{ req.purpose }}</td>

                            <td class="px-4 py-4">
                                <span class="px-2 py-1 rounded-full text-xs"
                                      ng-class="{
                                'bg-blue-100 text-blue-600': req.status === 'Processing',
                                'bg-yellow-100 text-yellow-700': req.status === 'Pending',
                                'bg-green-100 text-green-700': req.status === 'Completed',
                                'bg-gray-200 text-gray-600': req.status === 'Cancelled'
                              }">
                                    {{ req.status }}
                                </span>
                            </td>

                            <td class="px-4 py-4">
                                {{ (req.dateRequested .replace('/Date(', '').replace(')/', '') * 1) | date:'yyyy-MM-dd' }}
                            </td>

                            <td class="px-4 py-4">{{ req.priority }}</td>

                            <td class="px-4 py-4">
                                <button class="text-blue-500 hover:text-blue-700"
                                        ng-click="navigate('ViewRequestOfDetails', req.requestId)">
                                    View
                                </button>
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>
        </div>

    </div>
</main>