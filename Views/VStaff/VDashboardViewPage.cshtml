@{
    Layout = "~/Views/Shared/_VStaffLayoutPage.cshtml";
}
<main class="app-container">
    <div class="main-content">
        <div class="content-wrapper p-6">
            <h1 class="greeting-user">Staff Dashboard</h1>
            <p class="shortDescription">Manage document requests for Barangay 51</p>
        </div>
        <div class="content-wrapper2">
            <div class="stat-card border border-[#BEDBFF] bg-[#EFF6FF]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#2B7FFF]">Processing</p>
                        <p class="stat-number text-[#1C398E]">
                            {{ staffDashboard.processing }}
                        </p>
                    </div>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#2B7FFF" class="size-9">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>

                </div>
            </div>
            <div class="stat-card border border-[#FFF085] bg-[#FEFCE8]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#A65F00]">Waiting for Pickup</p>
                        <p class="stat-number text-[#733E0A]">
                            {{ staffDashboard.waitingPickup }}
                        </p>
                    </div>
                    <svg width="40" height="40" fill="none" stroke="#EAB308" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
            <div class="stat-card bg-[#F0FDF4] border border-[#B9F8CF]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#008236]">Completed</p>
                        <p class="stat-number text-[#0D542B]">
                            {{ staffDashboard.completed }}
                        </p>
                    </div>
                    <svg fill="none" width="40" height="40" viewBox="0 0 24 24" stroke-width="2" stroke="#6A7282" class="size-9">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </div>
            </div>
            <div class="stat-card bg-[#F9FAFB] border border-[#E5E7EB]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#364153]">Today's Workload'</p>
                        <p class="stat-number text-[#101828]">
                            {{ staffDashboard.todayWorkload }}
                        </p>
                    </div>
                    <svg fill="none" width="40" height="40" viewBox="0 0 24 24" stroke-width="2" stroke="#6A7282" class="size-9">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5l5 5v11a2 2 0 01-2 2z" />
                    </svg>
                </div>
            </div>
            <div class="stat-card bg-[#F9FAFB] border border-[#E5E7EB]">
                <div class="stat-card-inner">
                    <div>
                        <p class="stat-label text-[#364153]">Total Request</p>
                        <p class="stat-number text-[#101828]">
                            {{ staffDashboard.total }}
                        </p>
                    </div>
                    <svg fill="none" width="40" height="40" viewBox="0 0 24 24" stroke-width="2" stroke="#6A7282" class="size-9">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5l5 5v11a2 2 0 01-2 2z" />
                    </svg>
                </div>
            </div>
        </div>
        <div>
            <div class="card2">
                <h2 class="text-xl font-bold mb-6">Quick Actions</h2>
                <div class="content-wrapper2 md:flex gap-2">

                    <div class="stat-card flex-1 cursor-pointer group flex items-center gap-3 border hover:border-[#155DFC]">
                        <div class="stat-card-inner gap-4">
                            <div class="text-gray-500 group-hover:text-[#155DFC]">
                                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                                </svg>
                            </div>

                            <div class="flex flex-col" ng-click="navigate('ManageRequests')">
                                <h4 class="text-lg font-semibold text-[#101828]">Manage Requests</h4>
                                <p class="text-base text-[#4A5565]">View and process all requests</p>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card  flex-1 cursor-pointer group flex items-center gap-3 border hover:border-[#155DFC]">
                        <div class="stat-card-inner gap-4">
                            <div class="text-gray-500 group-hover:text-[#155DFC]">
                                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <div class="flex flex-col" ng-click="navigate('ListOfResidents')">
                                <h4 class="text-lg font-semibold text-[#101828]">Manage Resident</h4>
                                <p class="text-base text-[#4A5565]">Check resident information</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card2" ng-init="loadRecentRequests2()">

                <h2 class="text-base font-bold mb-3">Recent Requests</h2>
                <hr class="border-gray-200 mb-4">

                <!-- EMPTY STATE -->
                <div ng-if="!recentRequests2 || recentRequests2.length === 0">
                    <p class="text-xs text-gray-400">No requests found.</p>
                </div>

                <!-- LIST -->
                <div class="bg-white transition-all mb-2"
                     ng-repeat="req in recentRequests2 track by req.requestId">

                    <!-- Header -->
                    <div class="flex items-center justify-between mb-4">

                        <div class="flex items-center gap-2">

                            <h3 class="text-[15px] font-semibold text-gray-800">
                                {{ req.documentType }}
                            </h3>

                            <span class="px-2 py-0.5 rounded-full text-[10px] font-medium"
                                  ng-class="{
                        'bg-[#DBEAFE] text-[#2563EB]': req.status === 'Processing',
                        'bg-green-100 text-green-700': req.status === 'Approved',
                        'bg-yellow-100 text-yellow-700': req.status === 'Pending',
                        'bg-gray-200 text-gray-600': req.status === 'Cancelled'
                      }">
                                {{ req.status }}
                            </span>

                        </div>

                        <div class="text-[12px] font-medium">
                            {{ req.priority }}
                        </div>

                    </div>

                    <!-- Body -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">

                        <div>
                            <p class="text-[12px] text-gray-500 mb-1">Request ID</p>
                            <p class="text-[13px] font-bold text-gray-900">
                                {{ req.requestId }}
                            </p>
                        </div>

                        <div>
                            <p class="text-[12px] text-gray-500 mb-1">Resident</p>
                            <p class="text-[13px] font-bold text-gray-900">
                                {{ req.residentName }}
                            </p>
                        </div>

                        <div>
                            <p class="text-[12px] text-gray-500 mb-1">Purpose</p>
                            <p class="text-[13px] font-bold text-gray-900">
                                {{ req.purpose }}
                            </p>
                        </div>

                        <div>
                            <p class="text-[12px] text-gray-500 mb-1">Date Requested</p>
                            <p class="text-[13px] font-bold text-gray-900">
                                {{ (req.dateRequested.replace('/Date(', '').replace(')/', '') * 1) | date:'yyyy-MM-dd hh:mm a' }}
                            </p>
                        </div>

                    </div>

                    <hr class="my-4 border-gray-100">

                </div>
            </div>
        </div>
    </div>
</main>